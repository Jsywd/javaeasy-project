# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configurations: For persistent cloud database.
# If not provided, the application will fallback automatically to a local JSON database (database.json).
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# SMTP / Email Service Configurations for sending real verification emails:
# Example for Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="586", SMTP_USER="your-email@gmail.com", SMTP_PASS="your-app-password"
# Example for Resend/SendGrid/Mailtrap: set host, port, user, pass accordingly.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="JavaEasy <no-reply@javaeasy.com>"
RESEND_API_KEY=""
